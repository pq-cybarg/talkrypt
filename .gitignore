# --- build artifacts ---
/target
**/*.rs.bk
Cargo.lock.bak

# --- docs site (MkDocs / GitHub Pages build output) ---
/site
/.venv

# --- cargo-fuzz ---
/fuzz/target
/fuzz/artifacts
/fuzz/Cargo.lock
# Ignore the bulk auto-generated corpus, but keep checked-in regression seeds
# (inputs that once crashed a target — see fuzz/README.md).
/fuzz/corpus/*/*
!/fuzz/corpus/*/regression-*

# --- key material / secrets: NEVER track ---
*.key
*.onion_key
*.secret
*.pem
*.p8
*.pfx
hs_ed25519_secret_key
*identity*.bin
*.seed
/keys/
/secrets/
/state/
/.talkrypt/
*.sealed

# --- local config that may hold secrets or endpoints ---
config.local.*
*.local.toml
.env
.env.*

# --- runtime / logs (we avoid logging, but belt-and-suspenders) ---
*.log
/logs/

# --- OS / editor cruft (also an opsec hygiene matter) ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
# Claude Code per-machine local config (permissions etc.) — never commit. The
# shared project instructions live in the tracked top-level CLAUDE.md, NOT here.
.claude/

# Desktop packaging output (scripts/package.sh)
dist/

# EasyCrypt compiled artifacts
formal/*.eco

# Local /export + /compact session transcripts (never commit) — they contain the
# full session, including local filesystem paths / the OS account username.
*-this-session-is-being-continued-from-a-previous-c.txt
conversation-*.txt
*conversation*.txt
do-not-commit-*

# Vendored third-party crates ship SSH / PEM PRIVATE-KEY test fixtures, used only by
# those crates' own test suites (talkrypt never runs them — they are [patch] lib
# deps). Keep them on disk but NEVER track/push: GitHub secret-scanning (correctly)
# blocks private keys. Public keys (*.pub) are not secrets and stay tracked.
third-party/*/tests/examples/id_*
!third-party/*/tests/examples/id_*.pub
third-party/*/tests/**/*-priv.pem
